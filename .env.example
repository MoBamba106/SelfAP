# ---------------------------------------------------------------------------
# SelfAP — environment
#
# Copy to .env.local and fill in. Anything prefixed NEXT_PUBLIC_ is shipped to
# the browser; the service-role key never is and must never be.
# ---------------------------------------------------------------------------

# Supabase project — Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only. Bypasses row-level security. Used by `npm run seed`.
# Never expose this to the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Absolute origin, used for password-reset redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to 1 to run against the seeded in-memory store instead of Postgres.
# Also selected automatically when the Supabase variables above are absent.
# NEXT_PUBLIC_DEMO=1

# Used by `npm run db:push` (Supabase Management API).
# SUPABASE_ACCESS_TOKEN=sbp_xxx
# SUPABASE_PROJECT_REF=your-project-ref
